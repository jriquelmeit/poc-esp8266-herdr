<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.herdr.esp8266-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{PROJECT_DIR}}/bridge/run.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.config/herdr/esp8266-bridge.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.config/herdr/esp8266-bridge.err</string>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_DIR}}/bridge</string>
</dict>
</plist>
